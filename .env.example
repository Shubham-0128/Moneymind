# MoneyMind Backend Configuration
ENVIRONMENT=development

# Database Connection URL (PostgreSQL via psycopg v3 or fallback to SQLite)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moneymind
FALLBACK_TO_SQLITE=True

# Secret Key for auth token HMAC signatures.
# In production, this MUST be a cryptographically strong random string.
# In local development or tests, leaving it empty uses a safe local dev fallback.
SECRET_KEY=moneymind_dev_secret_key_for_local_use_only

# Permitted CORS Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5500

# Demo User Configuration (for evaluation / testing; disabled in production)
ENABLE_DEMO_USER=True
DEMO_USER_EMAIL=demo@moneymind.app
DEMO_USER_PASSWORD=Demo123!

# Anthropic API Key for AI Budgeting Coach (optional; local algorithmic fallback is used if omitted)
ANTHROPIC_API_KEY=your_anthropic_api_key_here


