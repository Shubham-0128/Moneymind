# MoneyMind Backend Configuration

# Database Connection URL (PostgreSQL via psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moneymind

# Secret Key for auth tokens & security
SECRET_KEY=moneymind_super_secret_dev_key_2026

# Fallback to local SQLite if PostgreSQL is unreachable in local dev
FALLBACK_TO_SQLITE=True

# Anthropic Claude API Key for MoneyMind AI Suggestions
ANTHROPIC_API_KEY=your_anthropic_api_key_here

